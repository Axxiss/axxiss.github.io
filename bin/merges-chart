#!/usr/bin/env python3
"""Render the merges-per-day chart for "Writing myself out of the loop".

    bin/merges-chart                       # everything up to today
    bin/merges-chart --end 2026-09-18      # stop on a finished day

Fetches the pull request history with `gh` and writes an inline SVG to
_includes/charts/merges-per-day.html, which the post includes.

Python rather than Ruby, the language of bin/check-links: this is an authoring
tool that never runs in CI or at build time, and it needs no gems.

**It is an SVG, not an image.** A PNG could not follow the palette, and a
charting library would need JavaScript, which the colophon promises the site
does not serve. Every colour here is a palette *role* — var(--strong) and the
rest — never a literal hue, so re-theming css/palette.css re-themes the chart.
Each bar carries a <title>, which is how the browser gives a tooltip with no
script.

The annotations belong to this post and are deliberately hard-coded: the shaded
stretch is the move onto the mini-PC, and the two dashed markers are the days
the schedule changed. A different post would want different ones.

Without --end the last day is still in progress, so it is drawn as an outline
rather than a fill. Publishing a solid bar for a part-finished day would show a
fall that has not happened.
"""
import argparse, collections, json, pathlib, subprocess, sys
from datetime import datetime, timedelta, timezone

MADRID = timezone(timedelta(hours=2))            # CEST, the clock the agents keep
W, H = 720, 250
L, R, T, B = 34, 10, 26, 34                      # margins: L leaves room for the y labels
GAP, RADIUS = 2, 4                               # 2px between bars, 4px on the data end
OUT = pathlib.Path('_includes/charts/merges-per-day.html')

TROUGH = (datetime(2026, 8, 23).date(), datetime(2026, 9, 1).date())
MARKERS = [(datetime(2026, 9, 8).date(), "two a night"),
           (datetime(2026, 9, 13).date(), "every 2 hours")]


def fetch(repo):
    out = subprocess.run(['gh', 'pr', 'list', '--repo', repo, '--state', 'all',
                          '--limit', '400', '--json', 'mergedAt'],
                         capture_output=True, text=True)
    if out.returncode:
        sys.exit(f"gh failed: {out.stderr.strip()}")
    return json.loads(out.stdout)


def series(prs, end=None):
    def local(t):
        return datetime.strptime(t, "%Y-%m-%dT%H:%M:%SZ").replace(
            tzinfo=timezone.utc).astimezone(MADRID).date()
    counts = collections.Counter(local(p['mergedAt']) for p in prs if p.get('mergedAt'))
    if not counts:
        sys.exit("no merged pull requests found")
    lo, hi = min(counts), max(counts)
    if end:
        hi = datetime.strptime(end, "%Y-%m-%d").date()
        counts = {d: n for d, n in counts.items() if d <= hi}
    days, d = [], lo
    while d <= hi:
        days.append((d, counts.get(d, 0)))
        d += timedelta(days=1)
    return days


def render(days, partial_last):
    plot_w, plot_h = W - L - R, H - T - B
    n = len(days)
    bw = (plot_w - GAP * (n - 1)) / n
    peak = max(v for _, v in days)
    # Round the axis up to a multiple of 5 so a record day never overflows the
    # plot; 20 is the floor so the shape stays comparable run to run.
    ymax = max(20, -(-peak // 5) * 5)
    x = lambda i: L + i * (bw + GAP)
    y = lambda v: T + plot_h - (v / ymax) * plot_h
    floor = T + plot_h
    today = days[-1][0] if partial_last else None
    at = {d: i for i, (d, _) in enumerate(days)}

    span = f"{days[0][0]:%-d %B} to {days[-1][0]:%-d %B %Y}"
    note = (" The final day is still in progress and is drawn as an outline."
            if partial_last else "")
    o = ['<figure class="chart">',
         f'<svg viewBox="0 0 {W} {H}" width="100%" role="img" aria-label="Pull requests '
         f'merged per day in personal-os, {span}.{note}">']

    # The wash runs from the left edge of the first trough day to the left edge
    # of the last. Both boundary days merged nothing, so no bar sits at either
    # end and the tint reads as the gap it is.
    a, b = TROUGH
    left_a, left_b = x(at[a]) - GAP/2, x(at[b]) - GAP/2
    o.append(f'<rect x="{left_a:.1f}" y="{T}" width="{left_b-left_a:.1f}" '
             f'height="{plot_h}" fill="var(--ochre-a12)"/>')
    o.append(f'<text x="{left_a+3:.1f}" y="{T-12}" font-size="10.5" '
             f'fill="var(--muted)">building the mini-PC</text>')


    for day, label in MARKERS:
        if day not in at:
            continue
        mx = x(at[day]) - GAP / 2
        o.append(f'<line x1="{mx:.1f}" y1="{T-6}" x2="{mx:.1f}" y2="{floor}" '
                 f'stroke="var(--muted)" stroke-width="1" stroke-dasharray="3 3"/>')
        o.append(f'<text x="{mx+4:.1f}" y="{T-12}" font-size="10.5" fill="var(--muted)">{label}</text>')

    for v in range(0, ymax + 1, 5):
        o.append(f'<line x1="{L}" y1="{y(v):.1f}" x2="{W-R}" y2="{y(v):.1f}" '
                 f'stroke="var(--rule)" stroke-width="1"/>')
        o.append(f'<text x="{L-7}" y="{y(v)+3.5:.1f}" text-anchor="end" font-size="10" '
                 f'fill="var(--meta)">{v}</text>')

    for day, count in days:
        if not count:
            continue                              # a day with no merges shows the gap
        i = at[day]
        top, left = y(count), x(i)
        r = min(RADIUS, floor - top)
        path = (f'M{left:.1f},{floor} V{top+r:.1f} Q{left:.1f},{top:.1f} {left+r:.1f},{top:.1f} '
                f'H{left+bw-r:.1f} Q{left+bw:.1f},{top:.1f} {left+bw:.1f},{top+r:.1f} V{floor} Z')
        if day == today:
            o.append(f'<path d="{path}" fill="none" stroke="var(--strong)" stroke-width="1.5">'
                     f'<title>{day:%-d %b} — {count} merged so far, day still running</title></path>')
            o.append(f'<text x="{left+bw/2:.1f}" y="{top-6:.1f}" text-anchor="middle" '
                     f'font-size="9.5" fill="var(--muted)">so far</text>')
        else:
            o.append(f'<path d="{path}" fill="var(--strong)">'
                     f'<title>{day:%-d %b} — {count} merged</title></path>')

    o.append(f'<line x1="{L}" y1="{floor}" x2="{W-R}" y2="{floor}" stroke="var(--meta)" stroke-width="1"/>')
    for i, (day, _) in enumerate(days):
        if i % 5:
            continue                              # every fifth day, or the labels collide
        o.append(f'<text x="{x(i)+bw/2:.1f}" y="{floor+15}" text-anchor="middle" '
                 f'font-size="10" fill="var(--meta)">{day:%-d %b}</text>')

    o += ['</svg>',
          '<figcaption>Pull requests merged per day in <code>personal-os</code>. The shaded '
          'stretch is the move onto the mini-PC.'
          + (' The last bar is today, still running.' if partial_last else '')
          + '</figcaption>',
          '</figure>']
    return "\n".join(o) + "\n"


if __name__ == '__main__':
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument('--repo', default='Axxiss/personal-os')
    ap.add_argument('--end', metavar='YYYY-MM-DD',
                    help='last day to plot; without it the final day is drawn as in progress')
    args = ap.parse_args()

    days = series(fetch(args.repo), args.end)
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(render(days, partial_last=args.end is None))
    print(f"{len(days)} days, {sum(v for _, v in days)} merges → {OUT}")
